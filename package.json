{
  "name": "mirolab-systems",
  "version": "1.0.3",
  "description": "Sistema de Laboratorio Clínico - Demo",
  "main": "main.js",
  "scripts": {
    "prestart": "npm run build:includes",
    "prebuild": "npm run build:includes",
    "build:includes": "node scripts/build-includes.js",
    "start": "node scripts/start.js",
    "migrar:catalogo": "node scripts/migrar-catalogo.js",
    "verificar:catalogo": "node scripts/migrar-catalogo.js --db=:memory: --sql-only",
    "limpiar:muerto": "node scripts/cleanup-dead-code.js",
    "build": "electron-builder --win --x64 --publish never",
    "postbuild": "electron-builder install-app-deps",
    "postinstall": "electron-builder install-app-deps"
  },
  "author": "Ing. Miguel Antonio Rojas Ramírez",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^8.7.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "electron": "^21.4.4",
    "electron-builder": "^24.9.1",
    "puppeteer": "^21.10.0"
  },
  "build": {
    "appId": "com.mirolab.systems",
    "productName": "MiroLabSystems",
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "icono.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MiroLab Systems",
      "installerIcon": "icono.ico",
      "uninstallerIcon": "icono.ico",
      "uninstallDisplayName": "MiroLab Systems",
      "runAfterFinish": true,
      "perMachine": false
    },
    "files": [
      "**/*",
      "!test-*.js",
      "!test-*/**"
    ]
  }
}